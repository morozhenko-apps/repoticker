{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoTicker",
  "version": "0.2.0",
  "identifier": "com.morozhenko.repoticker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RepoTicker",
        "width": 390,
        "height": 122,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true
      },
      {
        "label": "usage",
        "title": "RepoTicker GitHub Actions",
        "url": "quota.html",
        "width": 340,
        "height": 118,
        "minWidth": 340,
        "minHeight": 118,
        "maxWidth": 340,
        "maxHeight": 320,
        "visible": false,
        "resizable": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true
      },
      {
        "label": "settings",
        "title": "RepoTicker Settings",
        "url": "settings.html",
        "width": 660,
        "height": 720,
        "minWidth": 660,
        "minHeight": 720,
        "visible": false,
        "resizable": false,
        "decorations": true,
        "maxWidth": 660,
        "maxHeight": 720,
        "maximizable": false
      },
      {
        "label": "about",
        "title": "About RepoTicker",
        "url": "about.html",
        "width": 360,
        "height": 265,
        "minWidth": 360,
        "minHeight": 265,
        "maxWidth": 360,
        "maxHeight": 265,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight Git and GitHub Actions tray companion",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright (c) 2026 Stanislav Moseyko (morozhenko)",
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0"
        ]
      }
    }
  }
}
