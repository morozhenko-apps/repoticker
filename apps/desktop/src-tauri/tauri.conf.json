{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RepoTicker",
  "version": "0.1.0",
  "identifier": "com.morozhenko.repoticker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RepoTicker",
        "width": 390,
        "height": 122,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "RepoTicker Settings",
        "url": "settings.html",
        "width": 690,
        "height": 555,
        "minWidth": 560,
        "minHeight": 440,
        "visible": false,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
