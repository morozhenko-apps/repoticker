{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repoticker-download",
  "main": "src/worker.mjs",
  "account_id": "e5501830b73f9b3b7c730555e879856a",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "https://download.morozhenko.com/dist/RepoTicker/*", "zone_id": "ae58570320d7024d7fd5e97205b4ff76" }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "app-dist" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
